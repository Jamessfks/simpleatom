# Copy to .env.local for local development. Everything is optional for local
# mode: with no MACE_API_URL, calculations run in a local Python process.
# Reference: docs/reference/environment.md

# Remote backend (the Hugging Face Space). Unset = local mode.
# MACE_API_URL=https://<user>-mace-api.hf.space
# Shared secret; set the same value as a Space secret.
# MACE_API_TOKEN=

# MACE Link sharing (Supabase). Without these, sharing reports "unavailable".
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key; required before supabase/migrations/0003_lockdown.sql. Never NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin for share and citation links.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Profile and custom models (see docs/reference/contract.md).
# SIMPLEATOM_PROFILE=local
# ALLOW_CUSTOM_MODELS=1

# macOS: avoid "OMP: Error #15" when running Python directly.
KMP_DUPLICATE_LIB_OK=TRUE
