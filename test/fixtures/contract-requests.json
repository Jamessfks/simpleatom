{
  "$comment": "Request-level contract cases. Each is checked by BOTH mace-api/contract.py (test_scripts/test_backend_contract.py) and lib/contract.ts (test/contract.test.ts); the two must agree on every outcome, so the UI never refuses what the backend accepts or offers what it refuses.",
  "cases": [
    {
      "name": "empty request uses the defaults",
      "profile": "hosted",
      "params": {},
      "expect": "ok"
    },
    {
      "name": "MPA-0 medium",
      "profile": "hosted",
      "params": {
        "modelType": "MACE-MPA-0",
        "modelSize": "medium"
      },
      "expect": "ok"
    },
    {
      "name": "MPA-0 has no small",
      "profile": "hosted",
      "params": {
        "modelType": "MACE-MPA-0",
        "modelSize": "small"
      },
      "expect": "unsupported_model_size"
    },
    {
      "name": "MACE-OFF23 alias",
      "profile": "hosted",
      "params": {
        "modelType": "MACE-OFF23",
        "modelSize": "small"
      },
      "expect": "ok"
    },
    {
      "name": "phonon is refused",
      "profile": "hosted",
      "params": {
        "calculationType": "phonon"
      },
      "expect": "unsupported_calculation"
    },
    {
      "name": "unknown model",
      "profile": "hosted",
      "params": {
        "modelType": "MACE-MP"
      },
      "expect": "unsupported_model"
    },
    {
      "name": "custom without a checkpoint",
      "profile": "local",
      "params": {
        "modelType": "custom"
      },
      "expect": "custom_model_missing"
    },
    {
      "name": "custom checkpoint on hosted",
      "profile": "hosted",
      "params": {},
      "hasModelFile": true,
      "expect": "custom_models_disabled"
    },
    {
      "name": "custom checkpoint locally without ALLOW_CUSTOM_MODELS (D40: opt-in)",
      "profile": "local",
      "params": {},
      "hasModelFile": true,
      "expect": "custom_models_disabled"
    },
    {
      "name": "URL as a model size",
      "profile": "hosted",
      "params": {
        "modelType": "MACE-MP-0",
        "modelSize": "https://example.invalid/x.model"
      },
      "expect": "unsupported_model_size"
    },
    {
      "name": "bad precision",
      "profile": "hosted",
      "params": {
        "precision": "float16"
      },
      "expect": "unsupported_precision"
    },
    {
      "name": "bad device",
      "profile": "hosted",
      "params": {
        "device": "tpu"
      },
      "expect": "unsupported_device"
    },
    {
      "name": "string false is a boolean",
      "profile": "hosted",
      "params": {
        "dispersion": "false"
      },
      "expect": "ok"
    },
    {
      "name": "yes is not a boolean",
      "profile": "hosted",
      "params": {
        "dispersion": "yes"
      },
      "expect": "invalid_boolean"
    },
    {
      "name": "negative seed",
      "profile": "hosted",
      "params": {
        "seed": -1
      },
      "expect": "out_of_range"
    },
    {
      "name": "unknown ensemble",
      "profile": "hosted",
      "params": {
        "calculationType": "molecular-dynamics",
        "mdEnsemble": "NPH"
      },
      "expect": "unsupported_mdEnsemble"
    },
    {
      "name": "ensemble ignored for a single-point",
      "profile": "hosted",
      "params": {
        "mdEnsemble": "NPH"
      },
      "expect": "ok"
    },
    {
      "name": "timestep out of range",
      "profile": "hosted",
      "params": {
        "calculationType": "molecular-dynamics",
        "timeStep": 10
      },
      "expect": "out_of_range"
    },
    {
      "name": "NaN timestep",
      "profile": "hosted",
      "params": {
        "calculationType": "molecular-dynamics",
        "timeStep": "NaN"
      },
      "expect": "invalid_number"
    },
    {
      "name": "fractional step count",
      "profile": "hosted",
      "params": {
        "calculationType": "molecular-dynamics",
        "mdSteps": 10.5
      },
      "expect": "invalid_number"
    },
    {
      "name": "MD steps over the hosted cap",
      "profile": "hosted",
      "params": {
        "calculationType": "molecular-dynamics",
        "mdSteps": 20000
      },
      "expect": "limit_exceeded"
    },
    {
      "name": "MD steps fine locally",
      "profile": "local",
      "params": {
        "calculationType": "molecular-dynamics",
        "mdSteps": 20000
      },
      "expect": "ok"
    },
    {
      "name": "stray MD field on a single-point",
      "profile": "hosted",
      "params": {
        "mdSteps": 999999999
      },
      "expect": "ok"
    },
    {
      "name": "opt steps over the hosted cap",
      "profile": "hosted",
      "params": {
        "calculationType": "geometry-opt",
        "maxOptSteps": 3000
      },
      "expect": "limit_exceeded"
    },
    {
      "name": "fmax too loose",
      "profile": "hosted",
      "params": {
        "calculationType": "geometry-opt",
        "forceThreshold": 5
      },
      "expect": "out_of_range"
    },
    {
      "name": "CUDA on the hosted profile (ADR-0031: the public server is CPU-only)",
      "profile": "hosted",
      "params": {
        "device": "cuda"
      },
      "expect": "device_unavailable"
    },
    {
      "name": "CUDA locally (falls back to CPU with a warning at run time)",
      "profile": "local",
      "params": {
        "device": "cuda"
      },
      "expect": "ok"
    },
    {
      "name": "CPU on the hosted profile",
      "profile": "hosted",
      "params": {
        "device": "cpu"
      },
      "expect": "ok"
    },
    {
      "name": "D48: a fractional seed is refused, not truncated",
      "profile": "local",
      "params": {
        "seed": 3.7
      },
      "expect": "invalid_number"
    },
    {
      "name": "D48: an infinite seed string is refused",
      "profile": "local",
      "params": {
        "seed": "1e999"
      },
      "expect": "invalid_number"
    },
    {
      "name": "D48: a seed above 2^32-1 is out of range",
      "profile": "local",
      "params": {
        "seed": 4294967296
      },
      "expect": "out_of_range"
    },
    {
      "name": "parity: a hexadecimal number string is refused on both sides",
      "profile": "local",
      "params": {
        "seed": "0x10"
      },
      "expect": "invalid_number"
    },
    {
      "name": "parity: an underscored number string is refused on both sides",
      "profile": "local",
      "params": {
        "calculationType": "molecular-dynamics",
        "timeStep": "1_0"
      },
      "expect": "invalid_number"
    },
    {
      "name": "parity: a decimal number string is accepted on both sides",
      "profile": "local",
      "params": {
        "calculationType": "molecular-dynamics",
        "timeStep": " 0.5 "
      },
      "expect": "ok"
    },
    {
      "name": "parity: enumerated choices are trimmed on both sides",
      "profile": "local",
      "params": {
        "calculationType": "molecular-dynamics",
        "device": " cpu ",
        "precision": " float64",
        "mdEnsemble": "NVT "
      },
      "expect": "ok"
    },
    {
      "name": "parity: the step cap applies to a padded calculationType",
      "profile": "hosted",
      "params": {
        "calculationType": " molecular-dynamics ",
        "mdSteps": 20000
      },
      "expect": "limit_exceeded"
    },
    {
      "name": "parity: a padded modelSize is trimmed on both sides",
      "profile": "local",
      "params": {
        "modelType": "MACE-OFF",
        "modelSize": " small "
      },
      "expect": "ok"
    },
    {
      "name": "D123: a whitespace-only calculationType is treated as absent",
      "profile": "local",
      "params": {
        "calculationType": "   "
      },
      "expect": "ok"
    },
    {
      "name": "D123: a whitespace-only number is treated as absent",
      "profile": "local",
      "params": {
        "calculationType": "molecular-dynamics",
        "timeStep": "  "
      },
      "expect": "ok"
    },
    {
      "name": "D123: whitespace-only modelType and modelSize are treated as absent",
      "profile": "local",
      "params": {
        "modelType": "  ",
        "modelSize": " "
      },
      "expect": "ok"
    },
    {
      "name": "D124: a choice padded with U+0085 is refused on both sides",
      "profile": "local",
      "params": {
        "device": "cpu"
      },
      "expect": "unsupported_device"
    },
    {
      "name": "D124: a choice padded with a byte-order mark is refused on both sides",
      "profile": "local",
      "params": {
        "precision": "﻿float64"
      },
      "expect": "unsupported_precision"
    },
    {
      "name": "D125: an Arabic-Indic digit is not a number",
      "profile": "local",
      "params": {
        "seed": "٣"
      },
      "expect": "invalid_number"
    },
    {
      "name": "D125: a full-width digit is not a number",
      "profile": "local",
      "params": {
        "seed": "３"
      },
      "expect": "invalid_number"
    },
    {
      "name": "D139: a misspelled parameter is refused, not ignored",
      "profile": "local",
      "params": {
        "calculationType": "molecular-dynamics",
        "temprature": 300
      },
      "expect": "unknown_parameter"
    },
    {
      "name": "D139: every parameter the calculator sends is known",
      "profile": "local",
      "params": {
        "calculationType": "molecular-dynamics",
        "modelType": "MACE-OFF",
        "modelSize": "small",
        "precision": "float32",
        "device": "cpu",
        "dispersion": false,
        "temperature": 300,
        "pressure": 0,
        "timeStep": 0.5,
        "friction": 0.01,
        "mdSteps": 10,
        "mdEnsemble": "NVT",
        "forceThreshold": 0.05,
        "maxOptSteps": 10,
        "seed": 1,
        "customModelName": "m.model"
      },
      "expect": "ok"
    }
  ]
}
